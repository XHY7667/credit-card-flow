{
  "info": {
    "name": "CreditCardFlow Submission Demo",
    "description": "Submission-ready local demo. Business APIs use the API Gateway on port 8082; secured root-application actuator requests use serviceBaseUrl on port 8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}/actuator/health"
              ]
            },
            "description": "Expected 200 with status UP from the API Gateway."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status is UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}/api/v1/auth/login"
              ]
            },
            "description": "Authenticates a persisted enabled ADMIN AppUser. No registration API exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"accessToken present\", () => pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty);",
                  "if (body.accessToken) pm.environment.set(\"adminToken\", body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}/api/v1/auth/login"
              ]
            },
            "description": "Authenticates a persisted enabled USER AppUser.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"accessToken present\", () => pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty);",
                  "if (body.accessToken) pm.environment.set(\"userToken\", body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Merchant",
      "item": [
        {
          "name": "Create Merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": [
                "{{baseUrl}}/api/v1/merchants"
              ]
            },
            "description": "ADMIN creates an active synthetic merchant. Captures its database id for the implemented GET-by-id route.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantCode\": \"{{merchantCode}}\",\n  \"legalName\": \"Synthetic Demo Market LLC\",\n  \"displayName\": \"Synthetic Demo Market\",\n  \"merchantCategoryCode\": \"5411\",\n  \"countryCode\": \"US\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"merchant is active\", () => pm.expect(body.status).to.eql(\"ACTIVE\"));",
                  "if (body.id !== undefined) pm.environment.set(\"merchantId\", String(body.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Merchant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": [
                "{{baseUrl}}/api/v1/merchants/{{merchantId}}"
              ]
            },
            "description": "USER reads the created merchant by database id.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"merchant code matches\", () => pm.expect(pm.response.json().merchantCode).to.eql(pm.environment.get(\"merchantCode\")));"
                ]
              }
            }
          ]
        }
      ]
    },
