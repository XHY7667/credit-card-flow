    {
      "name": "06 Reversal",
      "item": [
        {
          "name": "Create Full Reversal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{reversalIdempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reversals",
              "host": [
                "{{baseUrl}}/api/v1/reversals"
              ]
            },
            "description": "Fully reverses Authorization #1. Expected COMPLETED; the authorization becomes REVERSED.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reversalReference\": \"{{reversalReference}}\",\n  \"authorizationReference\": \"{{authorizationReference}}\",\n  \"amount\": 200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"reversal completed\", () => pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replay Full Reversal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{reversalIdempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reversals",
              "host": [
                "{{baseUrl}}/api/v1/reversals"
              ]
            },
            "description": "Identical body and Idempotency-Key return the existing COMPLETED reversal with 201 and do not release credit again.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reversalReference\": \"{{reversalReference}}\",\n  \"authorizationReference\": \"{{authorizationReference}}\",\n  \"amount\": 200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"replay returns completed result\", () => pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Reversal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reversals/{{reversalReference}}",
              "host": [
                "{{baseUrl}}/api/v1/reversals/{{reversalReference}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
