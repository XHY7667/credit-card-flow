            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/authorizations/{{authorizationReference}}",
              "host": [
                "{{baseUrl}}/api/v1/authorizations/{{authorizationReference}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
