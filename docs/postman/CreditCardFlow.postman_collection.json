{
  "info": {
    "_postman_id": "5fe1eeea-a702-4c39-907f-c4777b2e0df4",
    "name": "CreditCardFlow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "merchantId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Merchant",
      "item": [
        {
          "name": "Create Merchant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set(\"merchantId\", response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantCode\": \"M300001\",\n  \"legalName\": \"Blue Harbor Retail LLC\",\n  \"displayName\": \"Blue Harbor Market\",\n  \"merchantCategoryCode\": \"5411\",\n  \"countryCode\": \"US\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants"]
            }
          }
        },
        {
          "name": "Get Merchant By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "merchants", "{{merchantId}}"]
            }
          }
        },
